{
  "name": "@theqrl/qrllib-browserify",
  "version": "1.1.0",
  "description": "browserified qrllib",
  "main": "index.js",
  "author": "Dr JP Lomas <jp@theqrl.org> (https://theqrl.org/)",
  "scripts": {
    "build": "browserify --ignore node:fs --global-transform ./scripts/export-qrllib.js --global-transform [ babelify --presets [ @babel/preset-env ] ] src/index.js -o dist/qrllib.js",
    "test": "npm run build && http-server dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theqrl/qrllib-browserify.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "dependencies": {
    "qrllib": "1.2.6"
  },
  "files": [
    "/dist/qrllib.js"
  ],
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "babelify": "10.0.0",
    "browserify": "17.0.1",
    "http-server": "14.1.1"
  }
}
